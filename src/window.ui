<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <template class="AmberolWindow" parent="GtkApplicationWindow">
    <property name="title">Ember</property>
    <property name="decorated">true</property>
    <property name="resizable">true</property>
    <property name="default-width">1024</property>
    <property name="default-height">700</property>
    <property name="width-request">640</property>
    <property name="height-request">480</property>
    <property name="titlebar">
      <object class="GtkHeaderBar" id="headerbar">
        <property name="show-title-buttons">true</property>
        <property name="decoration-layout">:minimize,maximize,close</property>
        <style>
          <class name="ember-headerbar"/>
        </style>
        <property name="title-widget">
          <object class="GtkLabel">
            <property name="label">EMBER</property>
            <style>
              <class name="title"/>
            </style>
          </object>
        </property>
      </object>
    </property>
    <child>
      <object class="DragOverlay" id="drag_overlay">
        <property name="title" translatable="yes">Drop files to add to the archive</property>
        <property name="child">
          <object class="GtkStack" id="main_stack">
            <property name="transition-type">crossfade</property>
            <property name="transition-duration">300</property>
            <property name="hexpand">true</property>
            <property name="vexpand">true</property>
            <property name="hhomogeneous">false</property>
            <property name="vhomogeneous">false</property>
            <child>
              <object class="GtkStackPage">
                <property name="name">initial-view</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="halign">center</property>
                    <property name="valign">center</property>
                    <property name="spacing">40</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">EMBER</property>
                        <style>
                          <class name="ember-logotype"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">your music, archived.</property>
                        <style>
                          <class name="ember-tagline"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="halign">center</property>
                        <property name="spacing">12</property>
                        <child>
                          <object class="GtkButton" id="restore_playlist_button">
                            <property name="label" translatable="yes">Restore Archive</property>
                            <property name="action-name">queue.restore-playlist</property>
                            <property name="visible">false</property>
                            <style>
                              <class name="ember-button-primary"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="add_folder_button">
                            <property name="label" translatable="yes">Open Folder</property>
                            <property name="action-name">queue.add-folder</property>
                            <style>
                              <class name="ember-button-primary"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton">
                            <property name="label" translatable="yes">Open Files</property>
                            <property name="action-name">queue.add-song</property>
                            <style>
                              <class name="ember-button-secondary"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">archive-view</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="hexpand">true</property>
                    <property name="vexpand">true</property>
                    <property name="overflow">hidden</property>
                    <child>
                      <object class="GtkCenterBox">
                        <property name="margin-top">28</property>
                        <property name="margin-start">32</property>
                        <property name="margin-end">32</property>
                        <property name="margin-bottom">12</property>
                        <property name="end-widget">
                          <object class="GtkBox">
                            <property name="spacing">8</property>
                            <child>
                              <object class="GtkButton">
                                <property name="label">&lt;</property>
                                <property name="action-name">win.show-main-menu</property>
                                <property name="sensitive">true</property>
                                <style>
                                  <class name="flat"/>
                                  <class name="ember-nav-arrow"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton">
                                <property name="label">&gt;</property>
                                <property name="sensitive">false</property>
                                <style>
                                  <class name="flat"/>
                                  <class name="ember-nav-arrow"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="EmberArchiveView" id="archive_view">
                        <property name="hexpand">true</property>
                        <property name="vexpand">true</property>
                        <property name="overflow">hidden</property>
                      </object>
                    </child>
                    <child>
                      <object class="AmberolPlaylistView" id="playlist_view">
                        <property name="visible">false</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">now-playing-view</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="hexpand">true</property>
                    <property name="vexpand">true</property>
                    <style>
                      <class name="ember-now-playing-page"/>
                    </style>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="halign">start</property>
                        <property name="valign">fill</property>
                        <property name="vexpand">true</property>
                        <property name="spacing">0</property>
                        <property name="width-request">270</property>
                        <child>
                          <object class="EmberVinylView" id="vinyl_view">
                            <property name="width-request">360</property>
                            <property name="valign">fill</property>
                            <property name="vexpand">true</property>
                            <style>
                              <class name="ember-vinyl-shifted"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="hover_label">
                            <property name="label"></property>
                            <property name="wrap">true</property>
                            <property name="justify">left</property>
                            <property name="halign">start</property>
                            <property name="hexpand">false</property>
                            <property name="max-width-chars">24</property>
                            <property name="ellipsize">end</property>
                            <property name="margin-start">12</property>
                            <property name="margin-bottom">7</property>
                            <property name="valign">end</property>
                            <property name="height-request">48</property>
                            <style>
                              <class name="ember-hover-label"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="valign">fill</property>
                        <property name="vexpand">true</property>
                        <property name="hexpand">true</property>
                        <property name="margin-top">24</property>
                        <property name="margin-end">28</property>
                        <property name="spacing">0</property>
                        <child>
                          <object class="GtkBox">
                            <property name="halign">end</property>
                            <property name="spacing">8</property>
                            <property name="margin-bottom">12</property>
                            <child>
                              <object class="GtkButton">
                                <property name="label">&lt;</property>
                                <property name="sensitive">false</property>
                                <style>
                                  <class name="flat"/>
                                  <class name="ember-nav-arrow"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton">
                                <property name="label">&gt;</property>
                                <property name="action-name">win.show-archive</property>
                                <property name="sensitive">true</property>
                                <style>
                                  <class name="flat"/>
                                  <class name="ember-nav-arrow"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AmberolLyricsView" id="lyrics_view">
                            <property name="hexpand">true</property>
                            <property name="vexpand">true</property>
                          </object>
                        </child>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="hexpand">true</property>
                                <property name="spacing">0</property>
                                <property name="margin-bottom">36</property>
                                <property name="valign">end</property>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">horizontal</property>
                                    <property name="spacing">16</property>
                                    <property name="margin-top">16</property>
                                    <property name="margin-bottom">12</property>
                                    <property name="hexpand">true</property>
                                    <child>
                                      <object class="GtkProgressBar" id="position_progress">
                                        <property name="hexpand">true</property>
                                        <property name="valign">center</property>
                                        <style>
                                          <class name="ember-progress-bar"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="remaining_label">
                                        <property name="label">0:00</property>
                                        <property name="valign">center</property>
                                        <style>
                                          <class name="ember-time-label"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">horizontal</property>
                                    <property name="hexpand">true</property>
                                    <property name="valign">center</property>
                                    <child>
                                      <object class="AmberolSongDetails" id="song_details">
                                        <property name="halign">start</property>
                                        <property name="hexpand">true</property>
                                        <property name="valign">center</property>
                                        <style>
                                          <class name="ember-song-details"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AmberolPlaybackControl" id="playback_control">
                                        <property name="halign">end</property>
                                        <property name="valign">center</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                </property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
  </template>
</interface>
