<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <template class="AmberolSongDetails" parent="GtkWidget">
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">4</property>
        <child>
          <object class="GtkLabel" id="song_title_label">
            <property name="ellipsize">end</property>
            <property name="halign">start</property>
            <property name="max-width-chars">24</property>
            <property name="single-line-mode">true</property>
            <style>
              <class name="ember-np-title"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="song_artist_label">
            <property name="ellipsize">end</property>
            <property name="halign">start</property>
            <property name="max-width-chars">28</property>
            <property name="single-line-mode">true</property>
            <style>
              <class name="ember-np-artist"/>
            </style>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
